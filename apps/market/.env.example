# Postgres. Locally any empty database; in production the Supabase connection
# string of mega-vitrina (Project settings → Database → Connection string).
DATABASE_URL=postgres://market:market@127.0.0.1:5432/karakol

# Which market opens at /
DEFAULT_SITE_SLUG=visit-karakol

# Cabinet sign-in code. Owner and tenants use the same code in this build;
# inside mega-hub the cabinet is behind Supabase auth and RLS instead.
CABINET_CODE=karakol
# Cookie signing secret. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Where tenant profiles and booking pages live (Vitrina, untouched by this app)
NEXT_PUBLIC_VITRINA_URL=https://vitrina.microp.app

# Same mega-vitrina project as Vitrina. Public pages read hub.*_cache here
# so edits in admin.microp.app show up after sync. Without these keys the
# app falls back to DATABASE_URL (standalone Postgres / Neon sandbox).
NEXT_PUBLIC_SUPABASE_URL=https://bfcfwaakxcqplamcswaq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Without a key the assistant answers from the site knowledge base
# by retrieval instead of an LLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
